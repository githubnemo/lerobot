# Pure frozen base Cosmos 3 Nano (early-exit layer 18/36, 4096-dim) + SmolExpert with physics augmentation for up to 10 epochs (BS 8, grad_accum 1 = 58,160 steps), early-stopping on val_flow_loss after 2,500 steps without improvement.
#! include: _smolexpert_online_base
#! include: _sort_cubes
--online-backbone cosmos3_nano
--backbone-checkpoint /home/anton/.cache/video-vam/cosmos3-nano
--backbone-layer 18
--backbone-prompt 'Grab the purple cube and put it into the cardboard box, ignore the other objects'
--dataset-revision a7c156de0e84a81e19457e6d783e4316e9f901e1
--normalizer-path outputs/train/sort-cubes-cosmos3-edge-optimized-bs64/normalizer.safetensors
--augment
--aug-strategy physics
--no-spatial-crop
--batch-size 8
--grad-accum-steps 1
--lr 1.5e-4
--warmup-steps 300
--min-steps 0
--max-steps 58160
--val-every 500
--patience 5
--select-metric val_flow_loss
--num-steps 3
--no-wandb
