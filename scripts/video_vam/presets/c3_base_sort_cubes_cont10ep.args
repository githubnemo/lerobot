# Continue training c3_base_sort_cubes_1ep for up to 10 more epochs (29,080 steps @ BS 16), stopping when val_flow_loss does not improve for 2,000 steps.
#! include: _smolexpert_online_base
#! include: _sort_cubes
--online-backbone cosmos3_edge
--backbone-checkpoint /home/anton/.cache/video-vam/cosmos3-edge
--backbone-layer 20
--backbone-prompt 'Grab the purple cube and put it into the cardboard box, ignore the other objects'
--dataset-revision a7c156de0e84a81e19457e6d783e4316e9f901e1
--model-checkpoint outputs/train/c3_base_sort_cubes_1ep/best.safetensors
--normalizer-path outputs/train/sort-cubes-cosmos3-edge-optimized-bs64/normalizer.safetensors
--augment
--aug-strategy physics
--no-spatial-crop
--batch-size 16
--grad-accum-steps 1
--lr 1.5e-4
--warmup-steps 100
--min-steps 0
--max-steps 29080
--val-every 500
--patience 4
--select-metric val_flow_loss
--num-steps 3
--no-wandb
